{
  "schema_version": 2,
  "seeds": [
    2028,
    2029,
    2030
  ],
  "languages": [
    "en-US",
    "vi-VN",
    "de-DE",
    "zh-CN"
  ],
  "models": [
    "word_tfidf",
    "char_tfidf",
    "xlmr"
  ],
  "conditions": [
    "clean",
    "mixed"
  ],
  "word_tfidf": {
    "ngram_range": [
      1,
      2
    ],
    "min_df": 2,
    "max_features": 100000,
    "sublinear_tf": true
  },
  "char_tfidf": {
    "ngram_range": [
      2,
      5
    ],
    "min_df": 2,
    "max_features": 150000,
    "sublinear_tf": true
  },
  "logistic_regression": {
    "C": 1,
    "max_iter": 1000,
    "solver": "lbfgs"
  },
  "xlmr": {
    "model_id": "FacebookAI/xlm-roberta-base",
    "max_epochs": 30,
    "patience": 10,
    "min_delta": 0,
    "learning_rate": 0.00002,
    "lr_scheduler_type": "linear",
    "warmup_ratio": 0,
    "weight_decay": 0.01,
    "max_length": 64,
    "batch_size": 16,
    "gradient_accumulation_steps": 2,
    "eval_batch_size": 64,
    "precision": "bf16",
    "logging_steps": 50,
    "save_total_limit": 2
  },
  "gpu_languages": {
    "0": "en-US",
    "1": "vi-VN",
    "2": "de-DE",
    "3": "zh-CN"
  },
  "cpu_workers": 2,
  "threads_per_worker": 4,
  "minimum_free_disk_gib": 25,
  "cleanup_completed_checkpoints": true
}
